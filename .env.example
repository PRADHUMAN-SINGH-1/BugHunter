# Required only for real, approved AI assessments via POST /api/assistant/message.
# The one-click demo uses local deterministic evidence and does not need this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Client configuration (set this in bughunter-ui/.env when the API is deployed elsewhere).
# REACT_APP_API_BASE_URL=https://api.example.com

# Keep false in deployed environments. Enable only for an authorized local target.
BUGHUNTER_ALLOW_PRIVATE_TARGETS=false
BUGHUNTER_REQUEST_TIMEOUT_MS=8000
BUGHUNTER_MAX_RESPONSE_BYTES=2000000
# Set the exact deployed frontend origin when needed.
BUGHUNTER_FRONTEND_ORIGIN=
